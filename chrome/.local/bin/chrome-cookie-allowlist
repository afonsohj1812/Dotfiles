#!/usr/bin/env python3
import json
import os
import subprocess
from urllib.parse import urlparse

BOOKMARKS = os.path.expanduser("~/.config/google-chrome/Default/Bookmarks")
POLICY = "/etc/opt/chrome/policies/managed/cookie-allowlist.json"
ALWAYS_KEEP = [
    "google.com",
]

def bookmark_hosts(path):
    with open(path) as f:
        data = json.load(f)
    hosts = []

    def walk(node):
        for child in node.get("children", []):
            if child.get("type") == "url":
                host = urlparse(child.get("url", "")).hostname
                if host:
                    hosts.append(host)
            elif child.get("type") == "folder":
                walk(child)

    walk(data["roots"]["bookmark_bar"])
    return hosts

def registrable_domain(host):
    try:
        out = subprocess.run(
            ["psl", "--print-reg-domain", host],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
        domain = out.split(":", 1)[1].strip() if ":" in out else out
        if domain and domain != "(null)":
            return domain
    except Exception:
        pass
    return host

def main():
    if not os.path.exists(BOOKMARKS):
        print(f"chrome-cookie-allowlist: no bookmarks yet at {BOOKMARKS}, skipping")
        return
    domains = sorted(
        {registrable_domain(h) for h in bookmark_hosts(BOOKMARKS)} | set(ALWAYS_KEEP)
    )
    policy = {
        "DefaultCookiesSetting": 1,
        "CookiesSessionOnlyForUrls": ["*"],
        "CookiesAllowedForUrls": [f"[*.]{d}" for d in domains],
    }
    tmp = POLICY + ".tmp"
    with open(tmp, "w") as f:
        json.dump(policy, f, indent=2)
        f.write("\n")
    os.replace(tmp, POLICY)
    print(f"chrome-cookie-allowlist: {len(domains)} domains -> {POLICY}")

if __name__ == "__main__":
    main()
