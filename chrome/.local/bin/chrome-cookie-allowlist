#!/usr/bin/env python3
"""Generate a Chrome managed policy that keeps cookies session-only for every
site EXCEPT the registrable domains of your bookmark-bar bookmarks.

DefaultCookiesSetting: 4  -> all cookies cleared when the browser closes
CookiesAllowedForUrls     -> bookmarked domains keep persistent cookies (stay logged in)

Run automatically by the chrome-cookie-allowlist.path user unit whenever the
Bookmarks file changes. Safe to run by hand too.
"""
import json
import os
import subprocess
from urllib.parse import urlparse

BOOKMARKS = os.environ.get(
    "CHROME_BOOKMARKS",
    os.path.expanduser("~/.config/google-chrome/Default/Bookmarks"),
)
POLICY = os.environ.get(
    "CHROME_COOKIE_POLICY",
    "/etc/opt/chrome/policies/managed/cookie-allowlist.json",
)
ALWAYS_KEEP = [
    "google.com",
]


def bookmark_hosts(path):
    """All hostnames found anywhere under the bookmark bar (folders included)."""
    with open(path) as f:
        data = json.load(f)
    hosts = []

    def walk(node):
        for child in node.get("children", []):
            if child.get("type") == "url":
                host = urlparse(child.get("url", "")).hostname
                if host:
                    hosts.append(host)
            elif child.get("type") == "folder":
                walk(child)

    walk(data["roots"]["bookmark_bar"])
    return hosts


def registrable_domain(host):
    """Collapse a hostname to its eTLD+1 using libpsl (handles gov.pt etc.)."""
    try:
        out = subprocess.run(
            ["psl", "--print-reg-domain", host],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
        # psl prints "queried.host: registrable.domain"
        domain = out.split(":", 1)[1].strip() if ":" in out else out
        if domain and domain != "(null)":
            return domain
    except Exception:
        pass
    return host  # fall back to the raw host if psl can't resolve it


def main():
    if not os.path.exists(BOOKMARKS):
        # Fresh install: Chrome hasn't synced bookmarks yet. The path unit will
        # re-run us once the Bookmarks file appears.
        print(f"chrome-cookie-allowlist: no bookmarks yet at {BOOKMARKS}, skipping")
        return
    domains = sorted(
        {registrable_domain(h) for h in bookmark_hosts(BOOKMARKS)} | set(ALWAYS_KEEP)
    )
    policy = {
        "DefaultCookiesSetting": 1,
        "CookiesSessionOnlyForUrls": ["*"],
        "CookiesAllowedForUrls": [f"[*.]{d}" for d in domains],
    }
    os.makedirs(os.path.dirname(POLICY), exist_ok=True)
    tmp = POLICY + ".tmp"
    with open(tmp, "w") as f:
        json.dump(policy, f, indent=2)
        f.write("\n")
    os.replace(tmp, POLICY)
    print(f"chrome-cookie-allowlist: {len(domains)} domains -> {POLICY}")


if __name__ == "__main__":
    main()
